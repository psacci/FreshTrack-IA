# Copy to .env to override defaults. All lines are optional.

# Use a different database file
# FRESHTRACK_DB=/path/to/freshtrack.db

# Use a custom YOLO model or freshness checkpoint
# FRESHTRACK_YOLO=models/food_detection/custom_food.pt
# FRESHTRACK_FRESHNESS_CKPT=models/freshness_classification/mobilenetv2_freshness.pt

# If Tesseract is installed somewhere unusual
# TESSERACT_CMD=/opt/homebrew/bin/tesseract

# Optional Roboflow Workflows inference. Rotate any key previously shared in chat.
# Set the replacement in your local .env; never paste it into source code or messages.
# ROBOFLOW_API_KEY=
# ROBOFLOW_WORKSPACE=blanks-workspace-suk8j
# ROBOFLOW_WORKFLOW_ID=foods-testing-mkupr
# ROBOFLOW_API_URL=https://serverless.roboflow.com
# ROBOFLOW_IMAGE_INPUT=image
# Add only parameters listed by your workflow's generated API snippet.
# ROBOFLOW_WORKFLOW_PARAMETERS={"classes":"egg, cucumber"}
